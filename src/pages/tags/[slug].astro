---
import { getTerm, getEmDashCollection, decodeSlug } from "emdash";
import SyleeLayout from "../../layouts/SyleeLayout.astro";

const slug = decodeSlug(Astro.params.slug);
const term = slug ? await getTerm("tag", slug) : null;

if (!term) {
	return Astro.redirect("/404");
}

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	where: { tag: term.slug },
	orderBy: { published_at: "desc" },
});
Astro.cache.set(cacheHint);

function formatDate(date: Date | null | undefined): string {
	if (!date) return "";
	return date.toLocaleDateString("en-US", {
		year: "numeric",
		month: "short",
		day: "numeric",
	});
}

const latestYear = posts[0]?.data.publishedAt?.getFullYear() ?? posts[0]?.data.createdAt.getFullYear() ?? "—";
const oldestYear = posts.at(-1)?.data.publishedAt?.getFullYear() ?? posts.at(-1)?.data.createdAt.getFullYear() ?? "—";
---

<SyleeLayout title={`${term.label} - Tags - Sy Lee`} description={`Posts tagged with ${term.label}`}>
	<div class="sylee-tag-modern-page">
		<header class="sylee-modern-hero sylee-tag-detail-hero reveal">
			<div>
				<a href="/tags" class="sylee-back modern">← All Tags</a>
				<p class="sylee-eyebrow">Topic archive</p>
				<h1>{term.label}</h1>
				<p class="sylee-modern-subtitle">
					{posts.length} {posts.length === 1 ? "post" : "posts"} collected under this topic.
				</p>
			</div>
			<div class="sylee-tags-stats compact" aria-label="Tag stats">
				<span><strong>{posts.length}</strong> posts</span>
				<span><strong>{latestYear}</strong> latest</span>
				<span><strong>{oldestYear}</strong> oldest</span>
			</div>
		</header>

		{posts.length === 0 ? (
			<p class="sylee-empty-card">No posts with this tag yet.</p>
		) : (
			<div class="sylee-tag-modern-posts">
				{posts.map((post, index) => (
					<article class="sylee-tag-modern-post reveal" style={`transition-delay: ${Math.min(index * 45, 300)}ms`}>
						<a href={`/blog/${post.id}`}>
							<div class="sylee-tag-modern-post__date">
								<time>{formatDate(post.data.publishedAt)}</time>
							</div>
							<div class="sylee-tag-modern-post__body">
								<h2>{post.data.title}</h2>
								{post.data.excerpt && <p>{post.data.excerpt}</p>}
							</div>
							<span class="sylee-tag-modern-post__arrow">→</span>
						</a>
					</article>
				))}
			</div>
		)}
	</div>
</SyleeLayout>

<script>
	function initRevealObserver() {
		const observer = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) entry.target.classList.add("visible");
			});
		}, { threshold: 0.1, rootMargin: "-20px" });
		document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
	}
	initRevealObserver();
	document.addEventListener("astro:after-swap", initRevealObserver);
</script>
