---
import { getTaxonomyTerms, getEmDashCollection, getTermsForEntries, type TaxonomyTerm } from "emdash";
import Base from "../../layouts/Base.astro";

const [terms, { entries: posts, cacheHint }] = await Promise.all([
	getTaxonomyTerms("tag"),
	getEmDashCollection("posts", { orderBy: { published_at: "desc" }, limit: 500 }),
]);
Astro.cache.set(cacheHint);

const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((post) => post.data.id),
	"tag",
);
const counts = new Map<string, number>();
for (const postTags of tagsByEntry.values()) {
	for (const tag of postTags) counts.set(tag.slug, (counts.get(tag.slug) ?? 0) + 1);
}
type TagWithCount = TaxonomyTerm & { count: number };
const tags: TagWithCount[] = (terms ?? [])
	.map((tag: TaxonomyTerm) => ({ ...tag, count: counts.get(tag.slug) ?? 0 }))
	.filter((tag: TagWithCount) => tag.count > 0)
	.sort((a: TagWithCount, b: TagWithCount) => b.count - a.count || a.label.localeCompare(b.label));
---

<Base title="Tags - Sy Lee" description="Browse posts by tag">
	<div class="sylee-tags-page">
		<h1 class="sylee-tags-title reveal">Tags</h1>
		<div class="sylee-tags-cloud reveal reveal-delay-1">
			{tags.map((tag) => {
				const sizeClass = tag.count >= 6 ? "is-large" : tag.count >= 3 ? "is-medium" : "is-small";
				return (
					<a href={`/tags/${tag.slug}`} class={`sylee-tag ${sizeClass}`}>
						{tag.label}
						<span>({tag.count})</span>
					</a>
				);
			})}
		</div>
	</div>
</Base>

<style>
	.sylee-tags-page {
		max-width: 48rem;
		margin: 0 auto;
		padding: 3rem 1.25rem;
	}
	.sylee-tags-title {
		font-size: 1.875rem;
		line-height: 2.25rem;
		font-weight: 700;
		color: #111827;
		margin: 0 0 2rem;
	}
	.sylee-tags-cloud {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.sylee-tag {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		padding: 0.375rem 0.75rem;
		background: #f3f4f6;
		color: #374151;
		border-radius: 999px;
		text-decoration: none;
		transition:
			background 150ms ease,
			color 150ms ease;
	}
	.sylee-tag:hover { background: #ccfbf1; color: #0f766e; }
	.sylee-tag.is-large { font-size: 1.125rem; }
	.sylee-tag.is-medium { font-size: 1rem; }
	.sylee-tag.is-small { font-size: 0.875rem; }
	.sylee-tag span { color: #9ca3af; margin-left: 0.25rem; }
	.reveal { opacity: 0; transform: translateY(8px); transition: opacity 400ms ease-out, transform 400ms ease-out; }
	.reveal.visible { opacity: 1; transform: translateY(0); }
	.reveal-delay-1 { transition-delay: 50ms; }
	:global(html.dark) .sylee-tags-title { color: #f9fafb; }
	:global(html.dark) .sylee-tag { background: #1f2937; color: #d1d5db; }
</style>

<script>
	function initRevealObserver() {
		const observer = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) entry.target.classList.add("visible");
			});
		}, { threshold: 0.1, rootMargin: "-20px" });
		document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
	}
	initRevealObserver();
	document.addEventListener("astro:after-swap", initRevealObserver);
</script>
