---
import { getEmDashCollection, getTermsForEntries, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

const POSTS_PER_PAGE = 5;

const [{ entries: allPosts, cacheHint }, settings] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: 200,
	}),
	getSiteSettings(),
]);

Astro.cache.set(cacheHint);

resolveBlogSiteIdentity(settings);
const latestPosts = allPosts.slice(0, POSTS_PER_PAGE);
const latestTagIds = latestPosts.map((p) => p.data.id);
const tagsByEntry = await getTermsForEntries("posts", latestTagIds, "tag");

function formatDate(date: Date | null | undefined): string {
	if (!date) return "";
	return date.toLocaleDateString("en-US", {
		year: "numeric",
		month: "short",
		day: "numeric",
	});
}
---

<Base
	title="Sy Lee - Software Engineer"
	description="Personal website of a software engineer from Taiwan who is passionate about web development"
>
	<div class="sylee-home-page">
		<section class="sylee-hero">
			<div class="sylee-hero-inner">
				<img
					src="/avatar.jpg"
					alt="Avatar"
					class="sylee-avatar reveal"
				/>
				<h1 class="sylee-title reveal reveal-delay-1">
					My Style, My way, My blog
				</h1>
				<p class="sylee-intro reveal reveal-delay-2">
					I'm <span>SY</span>, a software engineer from Taiwan who is passionate about web development. I love writing code and staying up-to-date with the <a href="https://chat.sylee.dev/">latest web trends</a>.
				</p>
				<div class="reveal reveal-delay-3">
					<SocialLinks />
				</div>
			</div>
		</section>

		<section class="sylee-latest">
			<h2 class="sylee-section-title reveal">Latest Posts</h2>
			<div id="posts-list" class="sylee-posts-list">
				{latestPosts.map((post, index) => {
					const tags = tagsByEntry.get(post.data.id) ?? [];
					return (
						<article class={`sylee-post-item reveal reveal-delay-${Math.min(index + 1, 4)}`}>
							<a href={`/blog/${post.id}`} class="sylee-post-link">
								<div class="sylee-post-mainline">
									<h3>{post.data.title}</h3>
									<time>{formatDate(post.data.publishedAt)}</time>
								</div>
							</a>
							{tags.length > 0 && (
								<div class="sylee-post-tags">
									{tags.map((tag) => (
										<a href={`/tags/${tag.slug}`}>{tag.label}</a>
									))}
								</div>
							)}
						</article>
					);
				})}
			</div>

			<nav id="posts-pagination" class="sylee-pagination reveal reveal-delay-4">
				<button id="prev-page-btn" type="button" class="sylee-page-btn is-disabled" disabled>
					← Previous
				</button>
				<span id="page-indicator" class="sylee-page-indicator">Page 1</span>
				<button id="next-page-btn" type="button" class="sylee-page-btn">
					Next →
				</button>
			</nav>
			<div class="sylee-view-all reveal reveal-delay-4">
				<a href="/blog">View all posts →</a>
			</div>
		</section>
	</div>

	<script>
		function initLandingPagination() {
			const list = document.getElementById("posts-list");
			const prevButton = document.getElementById("prev-page-btn") as HTMLButtonElement | null;
			const nextButton = document.getElementById("next-page-btn") as HTMLButtonElement | null;
			const pageIndicator = document.getElementById("page-indicator");
			if (!list || !prevButton || !nextButton || !pageIndicator || list.dataset.ready === "true") return;
			const postsList: HTMLElement = list;
			const prevBtn: HTMLButtonElement = prevButton;
			const nextBtn: HTMLButtonElement = nextButton;
			const indicator: HTMLElement = pageIndicator;
			postsList.dataset.ready = "true";

			let currentPage = 1;
			let totalPages = 1;
			let loading = false;

			function formatDate(dateString: string): string {
				const date = new Date(dateString);
				return date.toLocaleDateString("en-US", {
					year: "numeric",
					month: "short",
					day: "numeric",
				});
			}

			function escapeHtml(str: string): string {
				const div = document.createElement("div");
				div.textContent = str;
				return div.innerHTML;
			}

			function setButtonState(button: HTMLButtonElement, enabled: boolean) {
				button.disabled = !enabled;
				button.classList.toggle("is-disabled", !enabled);
			}

			function updateButtons() {
				setButtonState(prevBtn, currentPage > 1);
				setButtonState(nextBtn, currentPage < totalPages);
				indicator.textContent = `Page ${currentPage} of ${totalPages}`;
			}

			function renderPosts(posts: Array<{ slug: string; title: string; date: string; tags: Array<{ name: string; slug: string }> }>) {
				postsList.innerHTML = "";
				for (const post of posts) {
					const article = document.createElement("article");
					article.className = "sylee-post-item";
					const tagsHtml = post.tags.length > 0
						? `<div class="sylee-post-tags">${post.tags.map((t) => `<a href="/tags/${escapeHtml(t.slug)}">${escapeHtml(t.name)}</a>`).join("")}</div>`
						: "";
					article.innerHTML = `
						<a href="/blog/${escapeHtml(post.slug)}" class="sylee-post-link">
							<div class="sylee-post-mainline">
								<h3>${escapeHtml(post.title)}</h3>
								<time>${formatDate(post.date)}</time>
							</div>
						</a>
						${tagsHtml}
					`;
					postsList.appendChild(article);
				}
			}

			async function goToPage(page: number) {
				if (loading) return;
				loading = true;
				postsList.style.transition = "opacity 150ms ease-out, transform 150ms ease-out";
				postsList.style.opacity = "0";
				postsList.style.transform = "translateY(8px)";
				try {
					const res = await fetch(`/api/posts?page=${page}&limit=5`);
					const data = await res.json();
					currentPage = data.page;
					totalPages = data.totalPages;
					await new Promise((r) => setTimeout(r, 150));
					renderPosts(data.posts);
					updateButtons();
					postsList.style.transition = "opacity 300ms ease-out, transform 300ms ease-out";
					postsList.style.opacity = "1";
					postsList.style.transform = "translateY(0)";
					postsList.scrollIntoView({ behavior: "smooth", block: "start" });
				} catch {
					postsList.style.opacity = "1";
					postsList.style.transform = "translateY(0)";
				} finally {
					loading = false;
				}
			}

			fetch("/api/posts?page=1&limit=5")
				.then((res) => res.json())
				.then((data) => {
					totalPages = data.totalPages;
					updateButtons();
				})
				.catch(() => {});

			prevBtn.addEventListener("click", () => {
				if (currentPage > 1) goToPage(currentPage - 1);
			});
			nextBtn.addEventListener("click", () => {
				if (currentPage < totalPages) goToPage(currentPage + 1);
			});
		}

		function initRevealObserver() {
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) entry.target.classList.add("visible");
					});
				},
				{ threshold: 0.1, rootMargin: "-20px" },
			);
			document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
		}

		initLandingPagination();
		initRevealObserver();
		document.addEventListener("astro:after-swap", () => {
			initLandingPagination();
			initRevealObserver();
		});
	</script>
</Base>

<style>
	.sylee-home-page {
		max-width: 64rem;
		margin: 0 auto;
		padding: 0 1.25rem;
	}
	.sylee-hero {
		margin-top: 8rem;
		margin-bottom: 4rem;
	}
	.sylee-hero-inner {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}
	.sylee-avatar {
		width: 5rem;
		height: 5rem;
		border-radius: 999px;
		margin-bottom: 2rem;
	}
	.sylee-title {
		font-family: var(--font-mono);
		font-size: clamp(2.25rem, 5vw, 3rem);
		line-height: 1;
		font-weight: 700;
		color: #111827;
		margin: 0 0 1.5rem;
	}
	.sylee-intro {
		font-size: 1.125rem;
		line-height: 1.75rem;
		color: #4b5563;
		max-width: 42rem;
		margin: 0 0 1rem;
	}
	.sylee-intro span {
		color: #111827;
		font-weight: 500;
	}
	.sylee-intro a {
		color: inherit;
		text-decoration: underline;
		transition: color 150ms ease;
	}
	.sylee-intro a:hover { color: #0d9488; }
	.sylee-latest { margin-bottom: 4rem; }
	.sylee-section-title {
		font-size: 1.5rem;
		line-height: 2rem;
		font-weight: 700;
		color: #111827;
		margin: 0 0 2rem;
	}
	.sylee-posts-list {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}
	.sylee-post-item {
		padding: 1rem 0;
		border-bottom: 1px solid #e5e7eb;
		transition: border-color 150ms ease;
	}
	.sylee-post-item:hover { border-bottom-color: #d1d5db; }
	.sylee-post-link {
		display: block;
		text-decoration: none;
	}
	.sylee-post-mainline {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
	}
	.sylee-post-mainline h3 {
		font-size: 1.125rem;
		line-height: 1.75rem;
		font-weight: 500;
		color: #111827;
		margin: 0;
		transition: color 150ms ease;
	}
	.sylee-post-link:hover h3 { color: #0d9488; }
	.sylee-post-mainline time {
		font-size: 0.875rem;
		line-height: 1.25rem;
		color: #6b7280;
		flex-shrink: 0;
	}
	.sylee-post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 0.5rem;
	}
	.sylee-post-tags a {
		font-size: 0.75rem;
		line-height: 1rem;
		padding: 0.25rem 0.5rem;
		background: #f3f4f6;
		color: #4b5563;
		border-radius: 0.25rem;
		text-decoration: none;
		transition:
			background 150ms ease,
			color 150ms ease;
	}
	.sylee-post-tags a:hover {
		background: #ccfbf1;
		color: #0f766e;
	}
	.sylee-pagination {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-top: 2rem;
		padding-top: 1.5rem;
	}
	.sylee-page-btn {
		border: none;
		background: transparent;
		padding: 0;
		font: inherit;
		font-weight: 500;
		color: #0d9488;
		cursor: pointer;
		transition: color 150ms ease;
	}
	.sylee-page-btn:hover { text-decoration: underline; }
	.sylee-page-btn.is-disabled {
		color: #9ca3af;
		cursor: default;
		text-decoration: none;
	}
	.sylee-page-indicator {
		font-size: 0.875rem;
		line-height: 1.25rem;
		color: #6b7280;
	}
	.sylee-view-all {
		margin-top: 1rem;
		text-align: center;
	}
	.sylee-view-all a {
		font-size: 0.875rem;
		color: #6b7280;
		text-decoration: none;
		transition: color 150ms ease;
	}
	.sylee-view-all a:hover {
		color: #374151;
		text-decoration: underline;
	}
	.reveal {
		opacity: 0;
		transform: translateY(8px);
		transition:
			opacity 400ms ease-out,
			transform 400ms ease-out;
	}
	.reveal.visible {
		opacity: 1;
		transform: translateY(0);
	}
	.reveal-delay-1 { transition-delay: 50ms; }
	.reveal-delay-2 { transition-delay: 100ms; }
	.reveal-delay-3 { transition-delay: 150ms; }
	.reveal-delay-4 { transition-delay: 200ms; }

	:global(html.dark) .sylee-title,
	:global(html.dark) .sylee-section-title,
	:global(html.dark) .sylee-post-mainline h3,
	:global(html.dark) .sylee-intro span { color: #f9fafb; }
	:global(html.dark) .sylee-intro,
	:global(html.dark) .sylee-post-mainline time,
	:global(html.dark) .sylee-page-indicator,
	:global(html.dark) .sylee-view-all a { color: #9ca3af; }
	:global(html.dark) .sylee-post-item { border-bottom-color: #374151; }
	:global(html.dark) .sylee-post-tags a { background: #1f2937; color: #d1d5db; }

	@media (max-width: 640px) {
		.sylee-home-page { max-width: 42rem; }
		.sylee-hero { margin-top: 4rem; }
		.sylee-post-mainline {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.5rem;
		}
	}
</style>
