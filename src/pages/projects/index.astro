---
import { getEmDashCollection } from "emdash";
import ResourceCards from "../../components/ResourceCards.astro";
import SyleeLayout from "../../layouts/SyleeLayout.astro";

export const prerender = false;

const kinds = [
	{ id: "project", label: "Projects" },
	{ id: "doc", label: "Docs" },
	{ id: "talk", label: "Talks" },
] as const;

const { entries, error, cacheHint } = await getEmDashCollection("works", {
	orderBy: { date: "desc" },
	limit: 200,
});
Astro.cache.set(cacheHint);

type ImageValue = { src?: string } | string | null | undefined;
type Resource = {
	type?: string;
	label?: string;
	url?: string;
	thumbnail?: ImageValue;
	visible?: boolean | null;
};

function coverSrc(value: unknown): string | undefined {
	if (typeof value === "string" && value) return value;
	if (value && typeof value === "object" && "src" in value && typeof value.src === "string") return value.src;
	return undefined;
}

const cards = entries.map((entry) => {
	const resources = (Array.isArray(entry.data.resources) ? entry.data.resources : []) as Resource[];
	const dateValue = entry.data.date as Date | string | undefined;
	return {
		entry,
		resources: resources.filter((resource) => resource.visible !== false && resource.url),
		cover: coverSrc(entry.data.cover),
		date: dateValue ? new Date(dateValue) : entry.data.publishedAt,
		kind: String(entry.data.kind || "project"),
	};
});

const groups = kinds
	.map((kind) => ({ ...kind, items: cards.filter((card) => card.kind === kind.id) }))
	.filter((group) => group.items.length > 0);
---

<SyleeLayout title="Projects - Sy Lee" description="Projects, documents, and talks">
	<div class="projects-wrap">
		<h1 class="sylee-blog-title reveal">Projects</h1>
		<p class="sylee-page-desc reveal">GitHub projects, documents, and slide decks.</p>

		{error && <p>Works collection is not available yet.</p>}
		{!error && groups.length === 0 && <p>No published works yet.</p>}

		{groups.map((group) => (
			<section class="project-group" id={group.id}>
				<h2>{group.label}</h2>
				<ul>
					{group.items.map((card) => (
						<li id={card.entry.id}>
							<article class="work-card">
								<h3>{card.entry.data.title}</h3>
								{card.entry.data.summary && <p>{card.entry.data.summary}</p>}
								{card.date && (
									<time>{card.date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}</time>
								)}
								<ResourceCards resources={card.resources} fallbackCover={card.cover} />
							</article>
						</li>
					))}
				</ul>
			</section>
		))}
	</div>
</SyleeLayout>

<style>
	.projects-wrap { max-width: 72rem; margin: 0 auto; padding: 3rem 1.25rem 4rem; }
	.project-group { margin-top: 2.5rem; }
	.project-group h2 { margin: 0 0 1rem; font-size: 1.25rem; color: #111827; }
	.project-group ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
	.work-card { height: 100%; border: 1px solid #e5e7eb; border-radius: 14px; background: #fff; padding: 1rem 1rem 1.1rem; }
	.work-card h3 { margin: 0 0 0.4rem; font-size: 1.15rem; color: #111827; }
	.work-card p { margin: 0 0 0.6rem; color: #4b5563; line-height: 1.5; }
	.work-card time { display: block; margin-bottom: 0.8rem; color: #6b7280; font-size: 0.85rem; }
</style>
