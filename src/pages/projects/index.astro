---
import { getEmDashCollection } from "emdash";
import ResourceCards from "../../components/ResourceCards.astro";
import SyleeLayout from "../../layouts/SyleeLayout.astro";

export const prerender = false;

const kinds = [
	{ id: "project", label: "Projects" },
	{ id: "doc", label: "Docs" },
	{ id: "talk", label: "Talks" },
] as const;

const { entries, error, cacheHint } = await getEmDashCollection("works", {
	orderBy: { date: "desc" },
	limit: 200,
});
Astro.cache.set(cacheHint);

type ImageValue = { src?: string } | string | null | undefined;
type Resource = {
	type?: string;
	label?: string;
	url?: string;
	thumbnail?: ImageValue;
	visible?: boolean | null;
};

function coverSrc(value: unknown): string | undefined {
	if (typeof value === "string" && value) return value;
	if (value && typeof value === "object" && "src" in value && typeof value.src === "string") return value.src;
	return undefined;
}

const cards = entries.map((entry) => {
	const resources = (Array.isArray(entry.data.resources) ? entry.data.resources : []) as Resource[];
	const dateValue = entry.data.date as Date | string | undefined;
	return {
		entry,
		resources: resources.filter((resource) => resource.visible !== false && resource.url),
		cover: coverSrc(entry.data.cover),
		date: dateValue ? new Date(dateValue) : entry.data.publishedAt,
		kind: String(entry.data.kind || "project"),
	};
});

const kindLabel = new Map<string, string>(kinds.map((kind) => [kind.id, kind.label]));

// Switcher tabs: "all" plus every kind that has at least one item
const tabs = [
	{ id: "all", label: "All", count: cards.length },
	...kinds
		.map((kind) => ({ ...kind, count: cards.filter((card) => card.kind === kind.id).length }))
		.filter((kind) => kind.count > 0),
];

// ?kind=doc filters on the server too, so links work without JavaScript
const requestedKind = Astro.url.searchParams.get("kind") ?? "all";
const activeKind = tabs.some((tab) => tab.id === requestedKind) ? requestedKind : "all";
const visibleCount = tabs.find((tab) => tab.id === activeKind)?.count ?? cards.length;
---

<SyleeLayout title="Projects - Sy Lee" description="Projects, documents, and talks">
	<section class="projects is-active" data-window="~/projects" data-window-meta={`${visibleCount} items`} data-projects>
		<h1 class="sylee-blog-title">ls ~/projects</h1>
		<p class="sylee-page-desc">GitHub projects, documents, and slide decks.</p>

		{error && <p class="projects-empty">Works collection is not available yet.</p>}
		{!error && cards.length === 0 && <p class="projects-empty">No published works yet.</p>}

		{cards.length > 0 && (
			<>
				{tabs.length > 1 && (
					<nav class="kind-tabs" aria-label="Filter by kind">
						{tabs.map((tab) => (
							<a
								href={tab.id === "all" ? "/projects" : `/projects?kind=${tab.id}`}
								class="kind-tab"
								data-kind-tab={tab.id}
								aria-current={tab.id === activeKind ? "page" : undefined}
							>
								{tab.label.toLowerCase()} <span class="kind-count">{tab.count}</span>
							</a>
						))}
					</nav>
				)}
				<ul class="work-grid">
					{cards.map((card) => (
						<li id={card.entry.id} data-kind={card.kind} hidden={activeKind !== "all" && card.kind !== activeKind}>
							<article class="work-card">
								<span class="work-kind">{kindLabel.get(card.kind) ?? card.kind}</span>
								<h3>{card.entry.data.title}</h3>
								{card.entry.data.summary && <p>{card.entry.data.summary}</p>}
								{card.date && (
									<time>{card.date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}</time>
								)}
								<ResourceCards resources={card.resources} fallbackCover={card.cover} />
							</article>
						</li>
					))}
				</ul>
			</>
		)}
	</section>
</SyleeLayout>

<script>
	// Instant kind filtering; the ?kind= links still work without JavaScript
	function initKindTabs() {
		const root = document.querySelector<HTMLElement>("[data-projects]");
		if (!root || root.dataset.ready === "true") return;
		root.dataset.ready = "true";
		const tabs = root.querySelectorAll<HTMLAnchorElement>("[data-kind-tab]");
		const items = root.querySelectorAll<HTMLElement>("[data-kind]");

		function apply(kind: string) {
			let shown = 0;
			items.forEach((item) => {
				const match = kind === "all" || item.dataset.kind === kind;
				item.hidden = !match;
				if (match) shown++;
			});
			tabs.forEach((tab) => {
				if (tab.dataset.kindTab === kind) tab.setAttribute("aria-current", "page");
				else tab.removeAttribute("aria-current");
			});
			root.dataset.windowMeta = `${shown} items`;
		}

		tabs.forEach((tab) => {
			tab.addEventListener("click", (event) => {
				event.preventDefault();
				const kind = tab.dataset.kindTab ?? "all";
				apply(kind);
				const url = new URL(location.href);
				if (kind === "all") url.searchParams.delete("kind");
				else url.searchParams.set("kind", kind);
				history.replaceState(null, "", url);
			});
		});

		// Re-apply from the URL in case a cached page was rendered for another ?kind
		const requested = new URL(location.href).searchParams.get("kind") ?? "all";
		if ([...tabs].some((tab) => tab.dataset.kindTab === requested)) apply(requested);
	}

	initKindTabs();
	document.addEventListener("astro:after-swap", initKindTabs);
</script>

<style>
	.projects .sylee-page-desc { margin-bottom: 1.25rem; }
	.projects-empty { margin: 0; font-family: var(--font-ui); color: var(--ctp-subtext0); }

	/* kind switcher: Waybar-style workspace pills */
	.kind-tabs { display: flex; flex-wrap: wrap; gap: 0.25rem; margin-bottom: 1.25rem; font-family: var(--font-ui); font-size: 0.8125rem; }
	.kind-tab { display: inline-flex; align-items: center; gap: 0.4rem; height: 1.6rem; padding-inline: 0.6rem; color: var(--ctp-subtext0); background: var(--ctp-mantle); border: 1px solid var(--ctp-surface0); text-decoration: none; }
	.kind-tab:hover { color: var(--ctp-text); background: var(--ctp-surface0); }
	.kind-tab[aria-current="page"] { color: var(--ctp-base); background: var(--ctp-blue); border-color: var(--ctp-blue); }
	.kind-count { opacity: 0.7; }

	.work-grid { list-style: none; padding: 0; margin: 0; display: grid; gap: calc(var(--wm-gap-in) * 2); grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
	.work-grid li { scroll-margin-top: calc(var(--wm-bar-height) + var(--wm-gap-out)); }
	.work-grid li[hidden] { display: none; }
	.work-card { height: 100%; border: 1px solid var(--ctp-surface0); background: var(--ctp-mantle); padding: 1rem 1rem 1.1rem; }
	.work-grid li:target .work-card { border-color: var(--ctp-blue); }
	.work-kind { display: inline-block; margin-bottom: 0.5rem; font-family: var(--font-ui); font-size: 0.7rem; color: var(--ctp-blue); }
	.work-kind::before { content: "["; color: var(--ctp-overlay1); }
	.work-kind::after { content: "]"; color: var(--ctp-overlay1); }
	.work-card h3 { margin: 0 0 0.4rem; font-family: var(--font-ui); font-size: 1rem; color: var(--ctp-text); }
	.work-card p { margin: 0 0 0.6rem; color: var(--ctp-subtext1); line-height: 1.55; }
	.work-card time { display: block; margin-bottom: 0.8rem; font-family: var(--font-ui); color: var(--ctp-subtext0); font-size: 0.75rem; }
</style>
