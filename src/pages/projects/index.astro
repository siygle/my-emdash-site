---
import { getEmDashCollection } from "emdash";
import ResourceCards from "../../components/ResourceCards.astro";
import SyleeLayout from "../../layouts/SyleeLayout.astro";

export const prerender = false;

const kinds = [
	{ id: "project", label: "Projects" },
	{ id: "doc", label: "Docs" },
	{ id: "talk", label: "Talks" },
] as const;

const { entries, error, cacheHint } = await getEmDashCollection("works", {
	orderBy: { date: "desc" },
	limit: 200,
});
Astro.cache.set(cacheHint);

type ImageValue = { src?: string } | string | null | undefined;
type Resource = {
	type?: string;
	label?: string;
	url?: string;
	thumbnail?: ImageValue;
	visible?: boolean | null;
};

function coverSrc(value: unknown): string | undefined {
	if (typeof value === "string" && value) return value;
	if (value && typeof value === "object" && "src" in value && typeof value.src === "string") return value.src;
	return undefined;
}

const cards = entries.map((entry) => {
	const resources = (Array.isArray(entry.data.resources) ? entry.data.resources : []) as Resource[];
	const dateValue = entry.data.date as Date | string | undefined;
	return {
		entry,
		resources: resources.filter((resource) => resource.visible !== false && resource.url),
		cover: coverSrc(entry.data.cover),
		date: dateValue ? new Date(dateValue) : entry.data.publishedAt,
		kind: String(entry.data.kind || "project"),
	};
});

const groups = kinds
	.map((kind) => ({ ...kind, items: cards.filter((card) => card.kind === kind.id) }))
	.filter((group) => group.items.length > 0);
---

<SyleeLayout title="Projects - Sy Lee" description="Projects, documents, and talks">
	<div class="projects-wrap">
		<header class="is-active" data-window="~/projects" data-window-meta={`${groups.length} groups`}>
			<h1 class="sylee-blog-title reveal">ls ~/projects</h1>
			<p class="sylee-page-desc reveal">GitHub projects, documents, and slide decks.</p>
			{error && <p>Works collection is not available yet.</p>}
			{!error && groups.length === 0 && <p>No published works yet.</p>}
		</header>

		{groups.map((group) => (
			<section class="project-group" id={group.id} data-window={`~/projects/${group.id}`} data-window-meta={`${group.items.length} items`}>
				<h2>{group.label}</h2>
				<ul>
					{group.items.map((card) => (
						<li id={card.entry.id}>
							<article class="work-card">
								<h3>{card.entry.data.title}</h3>
								{card.entry.data.summary && <p>{card.entry.data.summary}</p>}
								{card.date && (
									<time>{card.date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}</time>
								)}
								<ResourceCards resources={card.resources} fallbackCover={card.cover} />
							</article>
						</li>
					))}
				</ul>
			</section>
		))}
	</div>
</SyleeLayout>

<style>
	.projects-wrap { display: flex; flex-direction: column; gap: calc(var(--wm-gap-in) * 2); }
	.projects-wrap header .sylee-page-desc { margin-bottom: 0; }
	.project-group,
	.project-group li { scroll-margin-top: calc(var(--wm-bar-height) + var(--wm-gap-out)); }
	.project-group h2 { margin: 0 0 1rem; font-family: var(--font-ui); font-size: 1.125rem; color: var(--ctp-text); }
	.project-group h2::before { content: "❯ "; color: var(--ctp-green); }
	.project-group ul { list-style: none; padding: 0; margin: 0; display: grid; gap: calc(var(--wm-gap-in) * 2); grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
	.work-card { height: 100%; border: 1px solid var(--ctp-surface0); background: var(--ctp-mantle); padding: 1rem 1rem 1.1rem; }
	.project-group li:target .work-card { border-color: var(--ctp-blue); }
	.work-card h3 { margin: 0 0 0.4rem; font-family: var(--font-ui); font-size: 1rem; color: var(--ctp-text); }
	.work-card p { margin: 0 0 0.6rem; color: var(--ctp-subtext1); line-height: 1.55; }
	.work-card time { display: block; margin-bottom: 0.8rem; font-family: var(--font-ui); color: var(--ctp-subtext0); font-size: 0.75rem; }
</style>
