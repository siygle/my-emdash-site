---
import { decodeSlug, getEmDashEntry, getEntryTerms } from "emdash";
import { PortableText } from "emdash/ui";
import ResourceCards from "../../components/ResourceCards.astro";
import SyleeLayout from "../../layouts/SyleeLayout.astro";

export const prerender = false;

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const { entry, cacheHint } = await getEmDashEntry("works", slug);
if (!entry) return Astro.redirect("/404");
Astro.cache.set(cacheHint);

const tags = await getEntryTerms("works", entry.data.id, "tag").catch(() => []);
const cover = entry.data.cover as { src?: string; alt?: string } | string | undefined;
const coverSrc = typeof cover === "string" ? cover : cover?.src;
const resources = Array.isArray(entry.data.resources) ? entry.data.resources : [];
const hasVisibleResource = resources.some((resource) => resource?.visible !== false);
const workDate = entry.data.date
	? new Date(entry.data.date as string | Date)
	: entry.data.publishedAt;
---

<SyleeLayout
	title={`${entry.data.title} - Projects`}
	description={entry.data.summary || ""}
	image={coverSrc}
	type="article"
	content={{ collection: "works", id: entry.data.id, slug: entry.id }}
>
	<article class="sylee-article">
		<p><a href="/projects">← Projects</a></p>
		<header>
			<h1>{entry.data.title}</h1>
			<div class="sylee-article-meta">
				{workDate && <time>{workDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</time>}
				{entry.data.kind && <span>{entry.data.kind}</span>}
			</div>
			{entry.data.summary && <p>{entry.data.summary}</p>}
			{tags.length > 0 && (
				<div class="sylee-post-tags">
					{tags.map((tag) => <a href={`/tags/${tag.slug}`}>{tag.label}</a>)}
				</div>
			)}
		</header>
		{coverSrc && <img class="work-cover" src={coverSrc} alt={typeof cover === "object" ? cover?.alt || "" : ""} />}
		{entry.data.body && (
			<div class="sylee-prose">
				<PortableText value={entry.data.body} />
			</div>
		)}
		{hasVisibleResource && (
			<section>
				<h2>相關資源</h2>
				<ResourceCards resources={resources} fallbackCover={coverSrc} />
			</section>
		)}
	</article>
</SyleeLayout>

<style>
	.work-cover { width: 100%; border-radius: 12px; margin: 1.5rem 0; }
</style>
