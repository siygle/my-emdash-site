---
import { palettes } from "../palettes";
import { PALETTE_COOKIE, themeConfig } from "../theme.config";

const isLoggedIn = !!Astro.locals.user;
const pathname = Astro.url.pathname;

const workspaces = [
	{ href: "/", label: "home" },
	{ href: "/blog", label: "blog" },
	{ href: "/murmur", label: "murmur" },
	{ href: "/tags", label: "tags" },
	{ href: "/projects", label: "projects" },
	{ href: "/newsletter", label: "newsletter" },
];

const defaultPalette =
	palettes.find((palette) => palette.id === themeConfig.defaultPalette) ?? palettes[0];

function isActive(href: string) {
	if (href === "/") return pathname === "/";
	return pathname === href || pathname.startsWith(`${href}/`);
}

const searchIcon = `<svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg>`;
const rssIcon = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="6.18" cy="17.82" r="2.18" /><path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z" /></svg>`;
const adminIcon = `<svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.218.127.324.2.728.232 1.082.093l1.216-.477a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.241-.438.613-.431.992a7.723 7.723 0 010 .356c-.007.379.138.751.431.992l1.003.827c.424.35.534.955.26 1.431l-1.296 2.247a1.125 1.125 0 01-1.37.49l-1.216-.477c-.354-.139-.758-.107-1.082.093a6.57 6.57 0 01-.218.127c-.332.184-.582.496-.645.87l-.213 1.281c-.09.542-.56.94-1.11.94h-2.593c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.063-.374-.313-.686-.645-.87a6.52 6.52 0 01-.218-.127c-.324-.2-.728-.232-1.082-.093l-1.216.477a1.125 1.125 0 01-1.37-.49l-1.296-2.247a1.125 1.125 0 01.26-1.431l1.003-.827c.293-.241.438-.613.431-.992a7.723 7.723 0 010-.356c-.007-.379-.138-.751-.431-.992l-1.003-.827a1.125 1.125 0 01-.26-1.431l1.296-2.247a1.125 1.125 0 011.37-.49l1.216.477c.354.139.758.107 1.082-.093.071-.044.144-.087.218-.127.332-.184.582-.496.645-.87l.213-1.281z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>`;
---

<header class="waybar">
	<nav class="waybar-group" aria-label="Workspaces">
		<a href="/" class="waybar-avatar" aria-label="Home">
			<img src="/avatar.jpg" alt="" />
		</a>
		{workspaces.map((ws, index) => (
			<a
				href={ws.href}
				class="ws-pill"
				aria-current={isActive(ws.href) ? "page" : undefined}
				aria-label={ws.label}
			>
				<span class="ws-num">{index + 1}</span>
				<span class="ws-label">{ws.label}</span>
			</a>
		))}
	</nav>

	<time class="waybar-clock" data-waybar-clock aria-hidden="true"></time>

	<div class="waybar-group">
		<a href="/search" class="waybar-module" aria-label="Search" aria-current={isActive("/search") ? "page" : undefined}>
			<Fragment set:html={searchIcon} />
		</a>
		{themeConfig.paletteSwitcher && (
			<>
				<span class="waybar-sep" aria-hidden="true">│</span>
				<details class="palette-picker" data-palette-picker>
					<summary class="waybar-module" aria-label="Choose color palette">
						<span class="palette-dot" aria-hidden="true" />
						<span class="palette-current" data-palette-current>{defaultPalette.name}</span>
					</summary>
					<div class="palette-menu" role="listbox" aria-label="Color palettes">
						{palettes.map((palette) => (
							<button
								type="button"
								role="option"
								class="palette-option"
								data-palette-option={palette.id}
								aria-selected={palette.id === defaultPalette.id ? "true" : "false"}
							>
								<span
									class="palette-swatch"
									style={`--sw-bg: ${palette.swatch[0]}; --sw-fg: ${palette.swatch[1]}; --sw-accent: ${palette.swatch[2]};`}
									aria-hidden="true"
								/>
								<span class="palette-name">{palette.name}</span>
								<span class="palette-mode">{palette.mode}</span>
							</button>
						))}
					</div>
				</details>
			</>
		)}
		<span class="waybar-sep" aria-hidden="true">│</span>
		<a href="/blog/rss.xml" class="waybar-module" aria-label="RSS feed">
			<Fragment set:html={rssIcon} />
		</a>
		{isLoggedIn && (
			<>
				<span class="waybar-sep" aria-hidden="true">│</span>
				<a href="/_emdash/admin" class="waybar-module" aria-label="Admin" title="Admin">
					<Fragment set:html={adminIcon} />
				</a>
			</>
		)}
	</div>
</header>

<script>
	const clockFormat = new Intl.DateTimeFormat("en-GB", {
		weekday: "short",
		day: "2-digit",
		month: "short",
		hour: "2-digit",
		minute: "2-digit",
		hour12: false,
	});

	function initWaybarClock() {
		const clock = document.querySelector<HTMLElement>("[data-waybar-clock]");
		if (!clock || clock.dataset.ready === "true") return;
		clock.dataset.ready = "true";
		const tick = () => {
			clock.textContent = clockFormat.format(new Date()).replace(",", "");
		};
		tick();
		setInterval(tick, 30_000);
	}

	initWaybarClock();
	document.addEventListener("astro:after-swap", initWaybarClock);

	// Palette picker: set <html data-palette>, remember it in a cookie, sync labels
	function syncPaletteUi() {
		const active = document.documentElement.dataset.palette;
		document.querySelectorAll<HTMLButtonElement>("[data-palette-option]").forEach((option) => {
			const selected = option.dataset.paletteOption === active;
			option.setAttribute("aria-selected", String(selected));
			if (selected) {
				const name = option.querySelector(".palette-name")?.textContent ?? "";
				document.querySelectorAll("[data-palette-current]").forEach((label) => {
					label.textContent = name;
				});
			}
		});
	}

	function initPalettePicker() {
		const picker = document.querySelector<HTMLDetailsElement>("[data-palette-picker]");
		if (!picker || picker.dataset.ready === "true") return;
		picker.dataset.ready = "true";
		picker.querySelectorAll<HTMLButtonElement>("[data-palette-option]").forEach((option) => {
			option.addEventListener("click", () => {
				const id = option.dataset.paletteOption;
				if (!id) return;
				document.documentElement.dataset.palette = id;
				const secure = location.protocol === "https:" ? "; Secure" : "";
				document.cookie = `${PALETTE_COOKIE}=${id}; path=/; max-age=31536000; SameSite=Lax${secure}`;
				syncPaletteUi();
				picker.open = false;
			});
		});
		document.addEventListener("click", (event) => {
			if (picker.open && !picker.contains(event.target as Node)) picker.open = false;
		});
		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && picker.open) {
				picker.open = false;
				picker.querySelector("summary")?.focus();
			}
		});
		syncPaletteUi();
	}

	initPalettePicker();
	document.addEventListener("astro:after-swap", initPalettePicker);
</script>

<style>
	.waybar {
		position: sticky;
		top: 0;
		z-index: 50;
		height: var(--wm-bar-height);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding-inline: var(--wm-gap-out);
		background: color-mix(in srgb, var(--ctp-mantle) 92%, transparent);
		backdrop-filter: blur(6px);
		border-bottom: 1px solid var(--ctp-surface0);
		font-family: var(--font-ui);
		font-size: 0.8125rem;
		color: var(--ctp-subtext1);
	}
	.waybar-group {
		display: flex;
		align-items: center;
		gap: 0.2rem;
		min-width: 0;
	}
	.waybar-avatar {
		display: flex;
		margin-right: 0.35rem;
		flex-shrink: 0;
	}
	.waybar-avatar img {
		width: 1.25rem;
		height: 1.25rem;
		border-radius: 999px;
		object-fit: cover;
	}
	.ws-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		height: 1.5rem;
		padding-inline: 0.5rem;
		color: var(--ctp-subtext0);
		text-decoration: none;
		transition: color 120ms ease, background-color 120ms ease;
	}
	.ws-pill:hover {
		color: var(--ctp-text);
		background: var(--ctp-surface0);
	}
	.ws-num {
		color: var(--ctp-overlay1);
	}
	.ws-pill[aria-current="page"],
	.ws-pill[aria-current="page"] .ws-num {
		color: var(--ctp-base);
		background: var(--ctp-blue);
	}
	.waybar-clock {
		position: absolute;
		left: 50%;
		transform: translateX(-50%);
		color: var(--ctp-text);
		pointer-events: none;
	}
	.waybar-module {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 1.5rem;
		min-width: 1.75rem;
		padding-inline: 0.35rem;
		color: var(--ctp-subtext0);
		transition: color 120ms ease, background-color 120ms ease;
	}
	.waybar-module:hover,
	.waybar-module[aria-current="page"] {
		color: var(--ctp-blue);
		background: var(--ctp-surface0);
	}
	.waybar-module :global(svg) {
		width: 1rem;
		height: 1rem;
	}
	/* Palette picker */
	.palette-picker {
		position: relative;
	}
	.palette-picker summary {
		list-style: none;
		cursor: pointer;
		gap: 0.4rem;
	}
	.palette-picker summary::-webkit-details-marker {
		display: none;
	}
	.palette-picker[open] summary {
		color: var(--ctp-text);
		background: var(--ctp-surface0);
	}
	.palette-dot {
		width: 0.7rem;
		height: 0.7rem;
		background: var(--ctp-blue);
		box-shadow: inset -0.35rem 0 0 var(--ctp-text);
	}
	.palette-menu {
		position: absolute;
		top: calc(100% + var(--wm-gap-out));
		right: 0;
		width: 16rem;
		max-height: min(28rem, 70vh);
		overflow-y: auto;
		padding: calc(var(--wm-title-height) + 0.25rem) 0.25rem 0.25rem;
		background: var(--ctp-base);
		border: var(--wm-border-width) solid transparent;
		border-image: var(--wm-active-border) 1;
		z-index: 1000;
	}
	.palette-menu::before {
		content: "omarchy-theme-set";
		position: absolute;
		top: 0;
		inset-inline: 0;
		height: var(--wm-title-height);
		display: flex;
		align-items: center;
		padding-inline: 0.75rem;
		font-size: 0.75rem;
		color: var(--ctp-blue);
		background: var(--ctp-mantle);
		border-bottom: 1px solid var(--ctp-surface0);
	}
	.palette-option {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 0.5rem;
		width: 100%;
		padding: 0.25rem 0.5rem;
		font: inherit;
		text-align: left;
		color: var(--ctp-subtext1);
		background: transparent;
		border: 0;
		cursor: pointer;
	}
	.palette-option:hover,
	.palette-option:focus-visible {
		color: var(--ctp-text);
		background: var(--ctp-mantle);
	}
	.palette-option[aria-selected="true"] {
		color: var(--ctp-base);
		background: var(--ctp-blue);
	}
	.palette-swatch {
		width: 1.6rem;
		height: 0.9rem;
		background: linear-gradient(90deg, var(--sw-bg) 0 40%, var(--sw-fg) 40% 70%, var(--sw-accent) 70%);
		outline: 1px solid var(--ctp-surface0);
	}
	.palette-mode {
		font-size: 0.7rem;
		opacity: 0.7;
	}
	.waybar-sep {
		color: var(--ctp-surface2);
		user-select: none;
	}

	/* Narrow screens: numbers only, clock hidden (as Waybar on a small output) */
	@media (max-width: 1000px) {
		.waybar-clock {
			display: none;
		}
	}
	@media (max-width: 760px) {
		.ws-label,
		.palette-current {
			display: none;
		}
	}
</style>
