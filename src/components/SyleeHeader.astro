---

<header class="sylee-header">
	<nav class="sylee-nav">
		<a href="/" class="sylee-home" aria-label="Home">
			<img src="/avatar.jpg" alt="Avatar" class="sylee-home-avatar" />
		</a>

		<button type="button" class="sylee-menu-button" aria-label="Toggle menu" aria-expanded="false" data-menu-button>
			<svg class="sylee-menu-icon sylee-menu-open" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
			</svg>
			<svg class="sylee-menu-icon sylee-menu-close" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
			</svg>
		</button>

		<div class="sylee-desktop-nav">
			{navItems.map((item) => (
				<a href={item.href} class="sylee-nav-icon" aria-label={item.label}>
					<Fragment set:html={item.icon} />
					<span>{item.label}</span>
				</a>
			))}
			{isLoggedIn && (
				<a href="/_emdash/admin" class="sylee-nav-icon sylee-admin-icon" aria-label="Admin" title="Admin">
					<Fragment set:html={adminIcon} />
					<span>Admin</span>
				</a>
			)}
		</div>
	</nav>
	<div class="sylee-mobile-nav" data-mobile-menu>
		{navItems.map((item) => <a href={item.href}>{item.label}</a>)}
		{isLoggedIn && <a href="/_emdash/admin">Admin</a>}
	</div>
</header>

<script>
	function initSyleeMenu() {
		const button = document.querySelector("[data-menu-button]");
		const menu = document.querySelector("[data-mobile-menu]");
		if (!button || !menu || button.getAttribute("data-ready") === "true") return;
		button.setAttribute("data-ready", "true");
		button.addEventListener("click", () => {
			const open = button.getAttribute("aria-expanded") === "true";
			button.setAttribute("aria-expanded", String(!open));
			menu.classList.toggle("is-open", !open);
		});
		menu.querySelectorAll("a").forEach((link) => {
			link.addEventListener("click", () => {
				button.setAttribute("aria-expanded", "false");
				menu.classList.remove("is-open");
			});
		});
	}
	initSyleeMenu();
	document.addEventListener("astro:after-swap", initSyleeMenu);
</script>

<style>
	.sylee-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(255, 255, 255, 0.8);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid #e5e7eb;
	}
	.sylee-nav {
		max-width: 48rem;
		margin: 0 auto;
		padding: 1rem 1.25rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.sylee-home { display: flex; align-items: center; gap: 0.5rem; border-radius: 999px; }
	.sylee-home-avatar {
		width: 2rem;
		height: 2rem;
		border-radius: 999px;
		transition: transform 150ms ease;
	}
	.sylee-home-avatar:hover { transform: scale(1.05); }
	.sylee-desktop-nav {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.sylee-nav-icon {
		position: relative;
		color: #4b5563;
		transition:
			color 150ms ease,
			transform 150ms ease;
		text-decoration: none;
	}
	.sylee-nav-icon:hover {
		color: #111827;
		transform: translateY(-1px);
	}
	.sylee-nav-icon :global(svg) {
		width: 1.25rem;
		height: 1.25rem;
	}
	.sylee-nav-icon span {
		pointer-events: none;
		position: absolute;
		left: 50%;
		bottom: -2rem;
		transform: translateX(-50%);
		padding: 0.25rem 0.5rem;
		font-size: 0.75rem;
		line-height: 1rem;
		color: #fff;
		background: #1f2937;
		border-radius: 0.25rem;
		opacity: 0;
		transition: opacity 150ms ease;
		white-space: nowrap;
	}
	.sylee-nav-icon:hover span { opacity: 1; }
	.sylee-admin-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		margin-left: 0.15rem;
		border: 1px solid rgba(13, 148, 136, 0.18);
		border-radius: 999px;
		background: rgba(240, 253, 250, 0.75);
		color: #0d9488;
	}
	.sylee-admin-icon:hover {
		border-color: rgba(13, 148, 136, 0.38);
		background: #ccfbf1;
		color: #0f766e;
	}
	.sylee-menu-button {
		display: none;
		padding: 0.75rem;
		margin: -0.25rem;
		color: #4b5563;
		background: transparent;
		border: none;
		cursor: pointer;
	}
	.sylee-menu-icon { width: 1.5rem; height: 1.5rem; transition: transform 200ms ease; }
	.sylee-menu-close { display: none; }
	.sylee-menu-button[aria-expanded="true"] .sylee-menu-open { display: none; }
	.sylee-menu-button[aria-expanded="true"] .sylee-menu-close { display: block; transform: rotate(90deg); }
	.sylee-mobile-nav {
		display: none;
		border-top: 1px solid #e5e7eb;
		background: #fff;
		overflow: hidden;
		max-height: 0;
		opacity: 0;
		transition:
			max-height 200ms ease,
			opacity 200ms ease;
	}
	.sylee-mobile-nav a {
		display: block;
		padding: 0.75rem 1.25rem;
		color: #4b5563;
		text-decoration: none;
	}
	.sylee-mobile-nav a:hover { color: #111827; }
	.sylee-mobile-nav.is-open { max-height: 18rem; opacity: 1; }

	:global(html.dark) .sylee-header {
		background: rgba(17, 24, 39, 0.8);
		border-bottom-color: #374151;
	}
	:global(html.dark) .sylee-nav-icon,
	:global(html.dark) .sylee-menu-button,
	:global(html.dark) .sylee-mobile-nav a { color: #d1d5db; }
	:global(html.dark) .sylee-nav-icon:hover,
	:global(html.dark) .sylee-mobile-nav a:hover { color: #fff; }
	:global(html.dark) .sylee-mobile-nav { background: #111827; border-top-color: #374151; }

	@media (max-width: 640px) {
		.sylee-desktop-nav { display: none; }
		.sylee-menu-button { display: block; }
		.sylee-mobile-nav { display: block; }
	}
</style>
