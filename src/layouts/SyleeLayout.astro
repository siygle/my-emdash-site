---
import { getSiteSettings } from "emdash";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import SyleeHeader from "../components/SyleeHeader.astro";
import "../styles/sylee.css";

interface Props {
  title: string;
  pageTitle?: string | null;
  description?: string | null;
  image?: string | null;
  canonical?: string | null;
  robots?: string | null;
  type?: "website" | "article";
  publishedTime?: string | null;
  modifiedTime?: string | null;
  author?: string | null;
  content?: { collection: string; id: string; slug?: string | null };
}

const {
  title,
  pageTitle,
  description,
  image,
  canonical,
  robots,
  type = "website",
  publishedTime,
  modifiedTime,
  author,
  content,
} = Astro.props;

const settings = await getSiteSettings();
const siteTitle = settings.title || "Sy Lee";
const fullTitle = title.includes(siteTitle) ? title : `${title} — ${siteTitle}`;
const pageCtx = createPublicPageContext({
  Astro,
  kind: content ? "content" : "custom",
  pageType: type,
  title: fullTitle,
  pageTitle: pageTitle ?? title,
  description,
  canonical,
  image,
  content,
  seo: { ogImage: image, robots },
  articleMeta: { publishedTime, modifiedTime, author },
  siteName: siteTitle,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <link rel="alternate" type="application/rss+xml" title="Blog RSS" href="/blog/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="Newsletter RSS" href="/newsletter/rss.xml" />
    <EmDashHead page={pageCtx} />
  </head>
  <body class="sylee-page">
    <EmDashBodyStart page={pageCtx} />
    <SyleeHeader />
    <main>
      <slot />
    </main>
    <EmDashBodyEnd page={pageCtx} />
  </body>
</html>
