---
import { getSiteSettings } from "emdash";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import SyleeHeader from "../components/SyleeHeader.astro";
import StatusLine from "../components/StatusLine.astro";
import "../styles/sylee.css";
import "../styles/newsletter.css";
import PaletteHead from "../components/PaletteHead.astro";
import { themeConfig } from "../theme.config";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  publishedTime?: string | null;
  modifiedTime?: string | null;
  content?: { collection: string; id: string; slug?: string | null };
}

const {
  title,
  description,
  type = "website",
  publishedTime = null,
  modifiedTime = null,
  content
} = Astro.props;

const settings = await getSiteSettings();
const siteTitle = settings.title || "Newsletter Notes";
const siteTagline = settings.tagline || "An independent newsletter about technology, craft, and the web.";
const fullTitle = title && title !== siteTitle ? `${title} - ${siteTitle}` : siteTitle;
const pageCtx = createPublicPageContext({
  Astro,
  kind: content ? "content" : "custom",
  pageType: type,
  title: fullTitle,
  pageTitle: title || siteTitle,
  description: description || siteTagline,
  content,
  articleMeta: { publishedTime, modifiedTime },
  siteName: siteTitle
});
---

<!doctype html>
<html lang="zh-Hant" data-palette={themeConfig.defaultPalette}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description || siteTagline} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Newsletter RSS" href="/newsletter/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="Blog RSS" href="/blog/rss.xml" />
    <meta name="theme-color" content="#e6e9ef" />
    <Font cssVariable="--font-mono" preload />
    <PaletteHead />
    <EmDashHead page={pageCtx} />
  </head>
  <body class="sylee-page newsletter-page">
    <EmDashBodyStart page={pageCtx} />
    <SyleeHeader />

    <main>
      <div class="newsletter-main" data-window={`~/newsletter — ${title || siteTitle}`} data-window-meta="zh-Hant">
        <slot />
      </div>
    </main>
    <StatusLine label="newsletter" />
    <EmDashBodyEnd page={pageCtx} />
  </body>
</html>
