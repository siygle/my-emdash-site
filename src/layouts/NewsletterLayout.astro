---
import { getSiteSettings } from "emdash";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import SyleeHeader from "../components/SyleeHeader.astro";
import "../styles/sylee.css";
import "../styles/newsletter.css";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  publishedTime?: string | null;
  modifiedTime?: string | null;
  content?: { collection: string; id: string; slug?: string | null };
}

const {
  title,
  description,
  type = "website",
  publishedTime = null,
  modifiedTime = null,
  content
} = Astro.props;

const settings = await getSiteSettings();
const siteTitle = settings.title || "Newsletter Notes";
const siteTagline = settings.tagline || "An independent newsletter about technology, craft, and the web.";
const fullTitle = title && title !== siteTitle ? `${title} - ${siteTitle}` : siteTitle;
const pageCtx = createPublicPageContext({
  Astro,
  kind: content ? "content" : "custom",
  pageType: type,
  title: fullTitle,
  pageTitle: title || siteTitle,
  description: description || siteTagline,
  content,
  articleMeta: { publishedTime, modifiedTime },
  siteName: siteTitle
});
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description || siteTagline} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="RSS Feed" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
    <EmDashHead page={pageCtx} />
  </head>
  <body class="sylee-page newsletter-page">
    <EmDashBodyStart page={pageCtx} />
    <SyleeHeader />

    <main class="newsletter-container newsletter-main">
      <slot />
    </main>

    <footer class="newsletter-container newsletter-footer">
      <div>
        <a href="/newsletter">All Issues</a>
        <span>·</span>
        <a href="/rss.xml">RSS</a>
      </div>
    </footer>
    <EmDashBodyEnd page={pageCtx} />
  </body>
</html>
